{
  "name": "mewra-dependency-guard-companion",
  "displayName": "Mewra Dependency Guard — Supply Chain Scan",
  "description": "OSV and Trivy lockfile vulnerability checks for Mewra PreFlight.",
  "version": "0.3.0",
  "publisher": "mewra",
  "license": "MIT",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/mewra-lab/mewra-dependency-guard.git"
  },
  "homepage": "https://mewra.app",
  "bugs": {
    "url": "https://github.com/mewra-lab/mewra-dependency-guard/issues"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "vscode": "^1.137.0"
  },
  "extensionDependencies": [
    "mewra.mewra-preflight"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mewra-dependency-guard.configureScanner",
        "title": "Set Up Scanner",
        "category": "Mewra Dependency Guard"
      }
    ],
    "configuration": {
      "title": "Mewra Dependency Guard",
      "properties": {
        "mewraDependencyGuard.scannerMode": {
          "type": "string",
          "enum": [
            "local",
            "docker"
          ],
          "default": "local",
          "description": "Run OSV Scanner and Trivy from the local PATH, or from pinned Docker images. Docker is opt-in and mounts the workspace read-only."
        }
      }
    }
  },
  "main": "./dist/extension.cjs",
  "icon": "assets/brand/icon.png",
  "categories": [
    "Linters",
    "Testing",
    "Other"
  ],
  "keywords": [
    "security",
    "vulnerability",
    "osv",
    "trivy",
    "lockfile",
    "preflight",
    "mewra"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md}": "prettier --write"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm clean && pnpm build:extension",
    "build:extension": "esbuild src/extension/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs --sourcemap",
    "test": "vitest run",
    "prepare": "husky",
    "validate": "pnpm format:check && pnpm check && pnpm test && pnpm build",
    "vscode:prepublish": "pnpm build",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/vscode": "^1.137.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
